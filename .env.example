# TRAE Credential Reverse Engineering — Environment Configuration

# TraeWork CN API endpoint for credential validation
TRAE_API_BASE=https://api.trae.ai

# Path to TraeWork CN installation (auto-detected if empty)
# TRAE_INSTALL_PATH=C:\Users\You\AppData\Local\Programs\trae-work-cn

# Path to TraeWork CN data directory (auto-detected if empty)
# TRAE_DATA_PATH=C:\Users\You\AppData\Roaming\TraeWork CN

# Output directory for analysis results
OUTPUT_DIR=./output

# Frida configuration
FRIDA_DEVICE_ID=local
